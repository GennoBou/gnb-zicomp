{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gnb-zicomp",
  "version": "0.1.0",
  "identifier": "com.gennobou.zicomp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GNB ZipImageCompressor",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/gen_x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "cli": {
      "args": [
        {
          "name": "files",
          "description": "処理するファイル（複数可）",
          "takesValue": true,
          "multiple": true,
          "index": 1
        }
      ]
    }
  }
}
